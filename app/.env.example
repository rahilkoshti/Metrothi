# Copy to .env.local and fill in. All optional — the app runs without them.

# Mappls geocoding proxy (proxy/geocode-worker). When set, place search uses
# Mappls via the worker; when unset, it falls back to the free Photon (OSM)
# geocoder. See proxy/geocode-worker/README.md for deploy steps.
VITE_GEOCODE_PROXY_URL=
