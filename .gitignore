# wrangler files
.wrangler
.dev.vars*
!.dev.vars.example
.env*
!.env.example

# Large reference screen recordings kept locally, not in history
files/*.mp4

# Generated by scripts/analytics-dashboard.mjs. Holds rider aggregates read
# through service_role; §5.8 purges the source rows at 90 days, so a copy of
# them must not live in git forever.
analytics-dashboard.html

# Vitest writes its cache to a repo-root node_modules even though the app is
# the only package; there are no root dependencies.
node_modules/
